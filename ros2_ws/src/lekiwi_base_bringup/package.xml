<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_base_bringup</name>
  <version>0.1.0</version>
  <description>ROS 2 driver and launch files for the LeKiwi 3-wheel omnidirectional mobile base.</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>lekiwi_hardware_interfaces</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>python3-numpy</depend>

  <exec_depend>lekiwi_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!--
    feetech-servo-sdk (import 名 scservo_sdk) にも依存するが rosdep キーが無い
    ため、ここには書けない。Dockerfile の pip install が唯一の導入経路。
    ネイティブ環境で使う場合は手動で `pip install feetech-servo-sdk` すること。
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
